#define ZMK_POINTING_DEFAULT_MOVE_VAL 700  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        parentheses {
            bindings = <&par_macro>;
            key-positions = <10 39>;
        };

        bracket {
            bindings = <&bracket_macro>;
            key-positions = <39 27>;
        };

        brace {
            bindings = <&brace_macro>;
            key-positions = <21 39>;
        };

        function_combo {
            bindings = <&function_macro>;
            key-positions = <16 39>;
        };

        arrow_combo {
            bindings = <&arrow_macro>;
            key-positions = <13 39>;
        };

        try_catch_combo {
            bindings = <&none>;
            key-positions = <5 39>;
        };
    };
};

/ {
    macros {
        function_macro: function_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp F &kp U &kp N &kp C &kp T &kp I &kp O &kp N &kp SPACE &kp LPAR &kp SPACE &kp RPAR &kp SPACE &kp LBRC &kp RIGHT_BRACE &kp LEFT &kp ENTER &kp UP_ARROW &kp END &kp LEFT_ARROW &kp LEFT_ARROW &kp LEFT &kp LEFT_ARROW &kp LEFT &kp LEFT_ARROW &kp SPACE>;

            label = "FUNCTION_MACRO";
        };

        arrow_macro: arrow_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp EQUAL &kp GT &kp SPACE>;

            label = "ARROW_MACRO";
        };

        par_macro: par_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LPAR &kp RPAR &kp LEFT_ARROW>;

            label = "PAR_MACRO";
        };

        bracket_macro: cor_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;

            label = "COR_MACRO";
        };

        brace_macro: brace_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW>;

            label = "BRACE_MACRO";
        };

        try_catch_macro: try_catch_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp T &kp R &kp Y &kp LBRC &kp ENTER &kp RIGHT_BRACE &kp C &kp A &kp T &kp C &kp H &kp SPACE &kp LPAR &kp SPACE &kp RPAR &kp SPACE &kp LBRC &kp RIGHT_BRACE &kp ENTER &kp UP_ARROW &kp UP_ARROW &kp END &kp LEFT_ARROW &kp SPACE &kp SPACE &kp LEFT_ARROW>;

            label = "TRY_CATCH_MACRO";
        };

        acute: acute {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp RA(E) &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp RA(N) &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        // Hold-tap: tap = letter (instant), hold 200ms = accented letter.
        // tap-preferred + quick-tap-ms keeps fast typing & Cmd+letter combos working.

        ht_acute: ht_acute {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&acute>, <&kp>;
        };

        ht_tilde: ht_tilde {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&tilde>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q          &kp W  &ht_acute E E  &kp R  &kp T        &kp Y          &ht_acute U U  &ht_acute I I  &ht_acute O O  &kp P     &kp BACKSPACE
&kp LCTRL  &ht_acute A A  &kp S  &kp D          &kp F  &kp G        &kp H          &kp J          &kp K          &kp L          &kp SEMI  &kp SQT
&kp LSHFT  &kp Z          &kp X  &kp C          &kp V  &kp B        &ht_tilde N N  &kp M          &kp COMMA      &kp DOT        &kp FSLH  &kp ESC
                                 &kp LGUI       &mo 1  &kp SPACE    &kp RET        &mo 2          &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB       &kp N1           &kp N2  &kp N3       &kp N4    &kp N5            &kp N6         &kp N7              &kp N8          &kp N9         &kp N0     &kp DELETE
&trans        &msc SCRL_RIGHT  &trans  &kp INSERT   &kp HOME  &msc SCRL_DOWN    &kp LC(RIGHT)  &kp LG(LEFT_ARROW)  &kp UP_ARROW    &kp LG(RIGHT)  &kp RA(E)  &trans
&kp CAPSLOCK  &msc SCRL_LEFT   &trans  &kp LG(DEL)  &kp END   &msc SCRL_UP      &kp LC(LEFT)   &kp LEFT            &kp DOWN_ARROW  &kp RIGHT      &trans     &trans
                                       &kp LGUI     &trans    &kp SPACE         &kp RET        &trans              &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB       &kp EXCL         &kp AT      &kp HASH          &kp DLLR    &kp PRCNT         &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp DELETE
&kp LCTRL     &kp C_VOLUME_UP  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &bt BT_SEL 0      &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp CAPSLOCK  &kp C_VOL_DN     &trans      &kp LC(B)         &kp LC(C)   &bt BT_CLR_ALL    &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                           &kp LGUI          &trans      &kp SPACE         &kp RET    &trans     &kp RALT
            >;
        };
    };
};
